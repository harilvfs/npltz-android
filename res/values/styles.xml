<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
      material 3 is the source of truth for colour, shape, type and motion.
      palette overlays in palettes.xml only replace theme attributes, so every
      material component picks the colours up automatically.
    -->

    <style name="AppThemeBase" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.Npltz.BottomSheetDialog</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Npltz.AlertDialog</item>
    </style>

    <style name="AppTheme" parent="AppThemeBase" />

    <style name="AppThemeLightBase" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.Npltz.BottomSheetDialog</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Npltz.AlertDialog</item>
    </style>

    <style name="AppTheme.Light" parent="AppThemeLightBase" />

    <!-- fonts are still user selectable. the helper applies these to text. -->
    <style name="ThemeOverlay.Npltz.Font.Inter" parent="">
        <item name="android:fontFamily">@font/inter_regular</item>
    </style>

    <style name="ThemeOverlay.Npltz.Font.System" parent="">
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="ThemeOverlay.Npltz.Font.Mono" parent="">
        <item name="android:fontFamily">monospace</item>
    </style>

    <style name="ThemeOverlay.Npltz.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.Npltz.BottomSheet.Modal</item>
    </style>

    <style name="Widget.Npltz.BottomSheet.Modal" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">?attr/colorSurfaceContainerLow</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Npltz.BottomSheet</item>
        <item name="android:paddingTop">8dp</item>
    </style>

    <style name="ShapeAppearance.Npltz.BottomSheet" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="ThemeOverlay.Npltz.AlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Npltz.AlertDialog</item>
    </style>

    <style name="ShapeAppearance.Npltz.AlertDialog" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerSize">28dp</item>
    </style>

    <style name="Widget.Npltz.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">?attr/colorSurfaceContainer</item>
        <item name="cardCornerRadius">28dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Widget.Npltz.Card.SurfaceLow" parent="Widget.Npltz.Card">
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerLow</item>
    </style>

    <style name="Widget.Npltz.Card.High" parent="Widget.Npltz.Card">
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerHigh</item>
    </style>

    <!-- sits on the page background itself: no fill, no edge. -->
    <style name="Widget.Npltz.Card.Flush" parent="Widget.Npltz.Card">
        <item name="cardBackgroundColor">?attr/colorSurface</item>
    </style>

    <style name="Widget.Npltz.Card.Row" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerHigh</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="TextAppearance.Npltz.Overline" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textSize">11sp</item>
        <item name="textAllCaps">false</item>
    </style>

    <!-- material 3 type roles, pinned to the bundled inter faces. -->
    <style name="TextAppearance.Npltz.DisplayLarge" parent="TextAppearance.Material3.DisplayLarge">
        <item name="fontFamily">@font/inter_medium</item>
    </style>
    <style name="TextAppearance.Npltz.DisplayMedium" parent="TextAppearance.Material3.DisplayMedium">
        <item name="fontFamily">@font/inter_medium</item>
    </style>
    <style name="TextAppearance.Npltz.DisplaySmall" parent="TextAppearance.Material3.DisplaySmall">
        <item name="fontFamily">@font/inter_medium</item>
    </style>
    <style name="TextAppearance.Npltz.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="fontFamily">@font/inter_medium</item>
    </style>
    <style name="TextAppearance.Npltz.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="fontFamily">@font/inter_medium</item>
    </style>
    <style name="TextAppearance.Npltz.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="fontFamily">@font/inter_medium</item>
    </style>
    <style name="TextAppearance.Npltz.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">@font/inter_medium</item>
    </style>
    <style name="TextAppearance.Npltz.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="fontFamily">@font/inter_medium</item>
    </style>
    <style name="TextAppearance.Npltz.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="fontFamily">@font/inter_medium</item>
    </style>
    <style name="TextAppearance.Npltz.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="fontFamily">@font/inter_regular</item>
    </style>
    <style name="TextAppearance.Npltz.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/inter_regular</item>
    </style>
    <style name="TextAppearance.Npltz.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="fontFamily">@font/inter_regular</item>
    </style>
    <style name="TextAppearance.Npltz.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">@font/inter_medium</item>
    </style>
    <style name="TextAppearance.Npltz.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="fontFamily">@font/inter_medium</item>
    </style>
    <style name="TextAppearance.Npltz.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="fontFamily">@font/inter_medium</item>
    </style>

    <style name="ThemeOverlay.Npltz.Typography" parent="">
        <item name="textAppearanceDisplayLarge">@style/TextAppearance.Npltz.DisplayLarge</item>
        <item name="textAppearanceDisplayMedium">@style/TextAppearance.Npltz.DisplayMedium</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.Npltz.DisplaySmall</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.Npltz.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.Npltz.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.Npltz.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.Npltz.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.Npltz.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.Npltz.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.Npltz.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.Npltz.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.Npltz.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.Npltz.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.Npltz.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.Npltz.LabelSmall</item>
    </style>

    <style name="TextAppearance.Npltz.SheetTitle" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.Npltz.SheetSubtitle" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="TextAppearance.Npltz.Section" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="textAllCaps">false</item>
    </style>

    <style name="TextAppearance.Npltz.Meta" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="Widget.Npltz.Segment" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/segment_text</item>
        <item name="backgroundTint">@color/segment_background</item>
        <item name="rippleColor">@color/segment_ripple</item>
        <item name="strokeColor">@color/segment_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:minWidth">92dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="ShapeAppearance.Npltz.Segment.Start" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">20dp</item>
        <item name="cornerSizeBottomLeft">20dp</item>
        <item name="cornerSizeTopRight">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="ShapeAppearance.Npltz.Segment.End" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">0dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeTopRight">20dp</item>
        <item name="cornerSizeBottomRight">20dp</item>
    </style>

    <style name="Widget.Npltz.IconButton" parent="Widget.Material3.Button.IconButton">
        <item name="android:padding">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="iconTint">?attr/colorOnSurfaceVariant</item>
        <item name="android:contentDescription">@null</item>
    </style>

    <style name="Widget.Npltz.IconButton.Filled" parent="Widget.Material3.Button.IconButton.Filled">
        <item name="android:padding">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="iconTint">?attr/colorOnPrimary</item>
    </style>

    <style name="Widget.Npltz.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@android:color/transparent</item>
        <item name="titleTextAppearance">?attr/textAppearanceTitleLarge</item>
        <item name="android:titleTextColor">?attr/colorOnSurface</item>
        <item name="subtitleTextAppearance">?attr/textAppearanceBodySmall</item>
        <item name="subtitleTextColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="Widget.Npltz.SettingsRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>

    <style name="Widget.Npltz.OptionRow" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerHigh</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="ShapeAppearance.Npltz.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="Widget.Npltz.Divider" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginStart">70dp</item>
        <item name="android:background">?attr/colorOutlineVariant</item>
    </style>

</resources>
